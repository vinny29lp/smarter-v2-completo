{
  "framework": "nextjs",
  "buildCommand": "rm -rf .vercel/output && prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/app/admin/cleanup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/lembretes-atraso",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/verificar-boletos-cora",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/fechar-mes",
      "schedule": "0 8 23 * *"
    },
    {
      "path": "/api/cron/emitir-boletos",
      "schedule": "0 11 2 * *"
    }
  ]
}
