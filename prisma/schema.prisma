generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  email         String         @unique
  password      String
  role          UserRole?      @default(ESTUDANTE)
  active        Boolean?       @default(true)
  franchiseId   String?
  companyId     String?
  createdAt     DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  lastLoginAt   DateTime?      @db.Timestamptz(6)
  activityLogs  ActivityLog[]
  employee      Employee?
  notifications Notification[]
  student       Student?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_company")
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Franchise {
  id                   String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                 String
  razaoSocial          String?
  cnpj                 String?              @unique
  cpf                  String?
  dataNasc             DateTime?            @db.Timestamptz(6)
  responsavel          String
  email                String
  telefone             String?
  cidade               String
  uf                   String
  endereco             String?
  cep                  String?
  status               FranchiseStatus?     @default(ATIVO)
  mensalidade          Float?               @default(200)
  cobrarMensalidade    Boolean              @default(true)
  plano                String?              @default("completo")
  pontuacao            Int?                 @default(0)
  chavePix             String?
  linkPagamento        String?
  instrucaoPagamento   String?
  createdAt            DateTime?            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  companies            Company[]
  contracts            Contract[]
  crmLeads             CrmLead[]
  employees            Employee[]
  financials           Financial[]
  gamification_configs GamificationConfig[]
  gamPoints            GamificationPoint[]
  students             Student[]
  users                User[]
  vacancies            Vacancy[]
  aiUsageLogs          AIUsageLog[]

  @@map("franchises")
}

model Company {
  id               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  razaoSocial      String
  cnpj             String         @unique
  setor            String?
  email            String
  telefone         String?
  responsavel      String?
  cargoResponsavel String?
  endereco         String?
  bairro           String?
  cidade           String
  uf               String
  cep              String?
  site             String?
  status           CompanyStatus? @default(ATIVA)
  franchiseId      String?
  createdAt        DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  pendente         Boolean?       @default(false)
  emailFinanceiro  String?
  valorGestao      Float?
  cpsStatus        String?        @default("NAO_GERADO")
  cpsAuthDocId     String?
  cpsSignedUrl     String?
  franchise        Franchise?     @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts        Contract[]
  crmLeads         CrmLead[]
  financials       Financial[]
  users            User[]
  vacancies        Vacancy[]

  @@index([franchiseId])
  @@index([status])
  @@map("companies")
}

model Institution {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  razaoSocial String?
  cnpj        String?
  tipo        String?
  email       String?
  telefone    String?
  coordenador String?
  cargoCoord  String?
  cidade      String?
  uf          String?
  endereco    String?
  cep         String?
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  cursos      String[]   @default([])
  site        String?
  updatedAt   DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)
  contracts   Contract[]
  students    Student[]

  @@map("institutions")
}

model Student {
  id                String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String         @unique
  name              String
  cpf               String?        @unique
  rg                String?
  dataNasc          DateTime?      @db.Timestamptz(6)
  sexo              String?
  email             String
  telefone          String?
  celular           String?
  endereco          String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  curso             String?
  periodo           String?
  semestre          String?
  previsaoConclusao String?
  institutionId     String?
  franchiseId       String?
  discResult        String?
  discData          Json?
  curriculo         Json?
  habilidades       String[]       @default([])
  idiomas           Json?
  observacoes       String?
  status            StudentStatus? @default(DISPONIVEL)
  createdAt         DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  menorDeIdade      Boolean?       @default(false)
  nomeResponsavel   String?
  linkedin          String?
  portfolio         String?
  experiencias      Json?
  formacoes         Json?
  objetivos         String?
  applications      Application[]
  contracts         Contract[]
  discTests         DiscTest[]
  franchise         Franchise?     @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution       Institution?   @relation(fields: [institutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@index([status])
  @@index([institutionId])
  @@map("students")
}

model Vacancy {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  titulo        String
  funcao        String?
  area          String?
  descricao     String?
  requisitos    String?
  beneficios    String?
  modalidade    String?        @default("Presencial")
  bolsa         Float
  auxTransporte Float?
  cargaHoraria  Int?           @default(30)
  chDiaria      Int?           @default(6)
  horario       String?
  cidade        String?
  uf            String?
  endereco      String?
  discDesejado   String?
  nivel          String?
  cursoRequerido String?
  status         VacancyStatus? @default(ABERTA)
  companyId     String
  franchiseId   String
  createdAt     DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  publicSlug    String?
  applications  Application[]
  company       Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise     Franchise      @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@index([franchiseId])
  @@index([status])
  @@map("vacancies")
}

model Application {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId       String
  vacancyId       String
  etapa           String?   @default("inscritos")
  matching        Int?
  anotacao        String?
  entrevistaAt    DateTime? @db.Timestamptz(6)
  status          String?   @default("ativo")
  createdAt       DateTime? @default(now()) @db.Timestamptz(6)
  anotacaoInterna String?
  parecerTecnico  String?
  entrevistaLocal String?
  entrevistaLink  String?
  recomendacao    String?
  student         Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vacancy         Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentId])
  @@index([vacancyId])
  @@unique([studentId, vacancyId])
  @@map("applications")
}

model Contract {
  id               String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  numero           String?
  studentId        String
  companyId        String
  institutionId    String?
  franchiseId      String
  bolsa            Float
  valorEmpresa     Float?
  auxTransporte    Float?
  beneficios       String?
  vencimento       Int?                 @default(5)
  dataInicio       DateTime             @db.Timestamptz(6)
  dataFim          DateTime             @db.Timestamptz(6)
  atividades       String?
  localEstagio     String?
  cidade           String?
  uf               String?
  chDiaria         Int?                 @default(6)
  chSemanal        Int?                 @default(30)
  diasSemana       String?              @default("Segunda a Sexta")
  horarioInicio    String?              @default("08:00")
  horarioFim       String?              @default("14:00")
  intervalo        Int?                 @default(60)
  supervisorNome   String?
  supervisorCargo  String?
  supervisorEmail  String?
  supervisorTel    String?
  supervisorAssina Boolean?             @default(false)
  coordNome        String?
  coordCargo       String?
  coordEmail       String?
  coordTel         String?
  apoliceSeguro    String?
  seguradora       String?
  tipoEstagio      String?              @default("Nao Obrigatorio")
  status           ContractStatus?      @default(PENDENTE)
  origem           String?              @default("NORMAL")
  migradoEm        DateTime?            @db.Timestamptz(6)
  migradoPor       String?
  migradoPorNome   String?
  tceMigradaUrl    String?
  createdAt        DateTime?            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise        Franchise            @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution      Institution?         @relation(fields: [institutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student              @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evaluations      Evaluation[]
  financials       Financial[]
  documents        InternshipDocument[]

  @@index([franchiseId])
  @@index([status])
  @@index([companyId])
  @@index([studentId])
  @@map("contracts")
}

model InternshipDocument {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  contractId  String
  tipo        String
  titulo      String
  status      DocStatus? @default(NAO_GERADO)
  htmlContent String?
  pdfUrl      String?
  signedUrl   String?
  signedAt    DateTime?  @db.Timestamptz(6)
  signers     Json?
  authDocId   String?
  metaData    Json?
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)
  contract    Contract   @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contractId])
  @@index([status])
  @@map("internship_documents")
}

model Evaluation {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  contractId   String
  tipo         String?   @default("semestral")
  link         String?   @unique
  respostas    Json?
  atividades   String?
  observacoes  String?
  status       String?   @default("pendente")
  respondidoAt DateTime? @db.Timestamptz(6)
  pdfUrl       String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(6)
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("evaluations")
}

model CrmLead {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresa         String
  contato         String?
  email           String?
  telefone        String?
  etapa           String?   @default("novo_lead")
  prioridade      String?   @default("media")
  valorNegociado  Float?
  retornoAt       DateTime? @db.Timestamptz(6)
  ultimoContato   DateTime? @db.Timestamptz(6)
  proximaAcao     String?
  anotacao        String?
  franchiseId     String?
  companyId       String?
  convertido      Boolean?  @default(false)
  createdAt       DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  linkReuniao     String?
  enderecoReuniao String?
  reuniaoAt       DateTime? @db.Timestamptz(6)
  situacao        String?   @default("ativo")
  etapaChangedAt  DateTime? @db.Timestamptz(6)
  optIn           Boolean?  @default(false)
  optInAt         DateTime? @db.Timestamptz(6)
  origem          String?
  setor           String?
  contratoHtml    String?   @db.Text
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise       Franchise? @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notas           CrmNota[]
  tasks           CrmTask[]

  @@index([franchiseId])
  @@index([situacao])
  @@index([updatedAt])
  @@map("crm_leads")
}

model CrmNota {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  leadId    String
  texto     String
  tipo      String    @default("anotacao")
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  lead      CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("crm_notas")
}

model CrmTask {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  leadId      String
  descricao   String
  dueAt       DateTime? @db.Timestamptz(6)
  done        Boolean?  @default(false)
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  linkReuniao String?
  endereco    String?
  lead        CrmLead   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("crm_tasks")
}

model Financial {
  id                 String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  descricao          String
  tipo               String
  valor              Float
  categoria          String?
  status             FinancialStatus? @default(PENDENTE)
  vencimentoAt       DateTime?        @db.Timestamptz(6)
  paidAt             DateTime?        @db.Timestamptz(6)
  cancelado          Boolean?         @default(false)
  franchiseId        String?
  companyId          String?
  contractId         String?
  createdAt          DateTime?        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  recorrente         Boolean?         @default(false)
  diaVencimento      Int?
  linkPagamento      String?
  chavePix           String?
  instrucaoPagamento String?
  sendLogs           FinancialSendLog[]
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract           Contract?        @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise          Franchise?       @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@index([status])
  @@index([contractId])
  @@index([companyId])
  @@index([vencimentoAt])
  @@map("financials")
}


model FinancialSendLog {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  financialId String
  emailEnviado String
  enviadoPor  String?
  enviadoAt   DateTime  @default(now()) @db.Timestamptz(6)
  status      String?   @default("enviado")
  mensagem    String?
  financial   Financial @relation(fields: [financialId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("financial_send_logs")
}

model DiscTest {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId String
  respostas Json
  resultado String
  grafico   Json
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("disc_tests")
}

model GamificationConfig {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  franchiseId String?
  acao        String
  pontos      Int
  ativo       Boolean?   @default(true)
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  franchises  Franchise? @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([franchiseId, acao])
  @@map("gamification_configs")
}

model GamificationPoint {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  franchiseId String
  acao        String
  pontos      Int
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ⚡ ESC-003: indexes para ranking groupBy e queries por franquia
  @@index([franchiseId])
  @@index([createdAt])
  @@map("gamification_points")
}

model ActivityLog {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?
  acao      String
  modulo    String?
  detalhes  String?
  ip        String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ⚡ ESC-003: indexes para auditoria por usuário e cleanup por data
  @@index([userId])
  @@index([createdAt])
  @@index([modulo])
  @@map("activity_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  titulo    String
  mensagem  String
  lida      Boolean?  @default(false)
  tipo      String?
  link      String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ⚡ ESC-003: indexes para query de notificações não lidas no dashboard
  @@index([userId])
  @@index([lida])
  @@index([createdAt])
  @@map("notifications")
}

model UploadedFile {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  nome         String
  url          String
  tipo         String?
  tamanho      Int?
  referencia   String?
  referenciaId String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(6)

  @@map("uploaded_files")
}

model Employee {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @unique
  franchiseId String?
  cargo       String?
  permissoes  String[]  @default([])
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@map("employees")
}

model SystemConfig {
  id             String    @id @default("default")
  razaoSocial    String?   @default("Smarter Estágios Agente de Integração Ltda.")
  cnpj           String?   @default("")
  endereco       String?   @default("")
  cidade         String?   @default("")
  uf             String?   @default("SP")
  telefone       String?   @default("")
  email          String?   @default("")
  responsavel    String?   @default("")
  pix            String?   @default("")
  apolice        String?   @default("")
  seguradora     String?   @default("")
  nomeFantasia   String?   @default("Smarter Estágios")
  slogan         String?   @default("Gestão completa de estágios")
  loginTitulo    String?   @default("Smarter Estágios")
  loginSubtitulo String?   @default("Sistema de Gestão de Estágios")
  loginSlogan    String?   @default("Plataforma completa para franqueadoras, franqueados, empresas e estudantes.")
  loginLogoUrl   String?   @default("")
  loginBgUrl     String?   @default("")
  logoDocUrl     String?   @default("")
  watermarkUrl   String?   @default("")
  watermarkText    String?   @default("SMARTER")
  autentiqueToken  String?   @default("")
  resendApiKey     String?   @default("")
  // Configurações de pagamento da Franqueadora (para cobrar os Franqueados)
  chavePix                   String?  @default("")
  linkPagamento              String?  @default("")
  instrucaoPagamento         String?  @default("")
  qrCodePixUrl               String?  @default("")
  mensagemCobrancaFranqueado String?  @default("")
  updatedAt        DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("system_configs")
}

enum UserRole {
  FRANQUEADORA
  FRANQUEADO
  EMPRESA
  ESTUDANTE
  FUNCIONARIO
  EQUIPE
}

enum FranchiseStatus {
  ATIVO
  INATIVO
  ATENCAO
}

enum CompanyStatus {
  ATIVA
  INATIVA
  ATENCAO
  PENDENTE
}

enum StudentStatus {
  DISPONIVEL
  EM_PROCESSO
  EM_ESTAGIO
  FINALIZADO
  INATIVO
}

enum VacancyStatus {
  ABERTA
  PAUSADA
  ENCERRADA
}

enum ContractStatus {
  PENDENTE
  AGUARDANDO_ASSINATURA
  ATIVO
  VENCIDO
  FINALIZADO
  SUSPENSO
  INATIVO
}

enum DocStatus {
  NAO_GERADO
  RASCUNHO
  GERADO
  ENVIADO_ASSINATURA
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

enum FinancialStatus {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

model AIUsageLog {
  id           String   @id @default(cuid())
  franchiseId  String
  userId       String?
  userEmail    String?
  tipoUso      String   // "vaga_descricao" | "tce_atividades" | "parecer" | "sugestao_testes" | "disc_perfil"
  promptTokens Int      @default(0)
  completionTokens Int  @default(0)
  totalTokens  Int      @default(0)
  custoEstimado Float   @default(0)
  modelo       String   @default("gpt-4.1-mini")
  sucesso      Boolean  @default(true)
  erro         String?
  createdAt    DateTime @default(now())

  franchise    Franchise @relation(fields: [franchiseId], references: [id])

  @@map("ai_usage_logs")
  @@index([franchiseId])
  @@index([userId])
  @@index([tipoUso])
  @@index([createdAt])
}

// ─── CRM DE VENDA DE FRANQUIAS ────────────────────────────────────────────────
// Separado do CrmLead (que é para parcerias empresariais).
// Leads captados de tráfego pago (Meta Ads), indicações ou orgânico.

model FranquiaLead {
  id            String         @id @default(cuid())
  nomeCompleto  String
  email         String?
  telefone      String?
  cidade        String?
  estado        String?
  etapa         String         @default("novo_lead")
  situacao      String         @default("ativo") // ativo | vendido | perdido
  origem        String?        // meta_ads | indicacao | organico | evento | outro
  leadFrio      Boolean        @default(false)   // importado com dados antigos
  optIn         Boolean        @default(true)
  anotacao      String?
  proximaAcao   String?
  ultimoContato DateTime?      @db.Timestamptz(6)
  retornoAt     DateTime?      @db.Timestamptz(6)
  etapaChangedAt DateTime?     @db.Timestamptz(6)
  valorInvestimento Float?     // valor negociado (taxa de franquia)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  notas         FranquiaNota[]
  tarefas       FranquiaTarefa[]

  @@index([etapa])
  @@index([situacao])
  @@index([leadFrio])
  @@index([createdAt])
  @@map("franquia_leads")
}

model FranquiaNota {
  id        String       @id @default(cuid())
  leadId    String
  texto     String
  tipo      String       @default("anotacao") // anotacao | email | whatsapp | etapa | alerta
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  lead      FranquiaLead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leadId])
  @@map("franquia_notas")
}

model FranquiaTarefa {
  id        String       @id @default(cuid())
  leadId    String
  descricao String
  dueAt     DateTime?    @db.Timestamptz(6)
  done      Boolean      @default(false)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  lead      FranquiaLead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leadId])
  @@map("franquia_tarefas")
}

// ──────────────────────────────────────────────────────────────────────────────

model ImportLog {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tipo        String
  franchiseId String?
  userId      String
  arquivo     String
  total       Int       @default(0)
  importados  Int       @default(0)
  duplicados  Int       @default(0)
  erros       Int       @default(0)
  detalhes    Json?     // Salva erros e duplicados por linha para consulta posterior
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)

  @@map("import_logs")
}
