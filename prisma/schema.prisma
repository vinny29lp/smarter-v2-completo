generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  email         String         @unique
  password      String
  role          UserRole?      @default(ESTUDANTE)
  active        Boolean?       @default(true)
  franchiseId   String?
  companyId     String?
  createdAt     DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  lastLoginAt   DateTime?      @db.Timestamptz(6)
  activityLogs  ActivityLog[]
  employee      Employee?
  notifications Notification[]
  student       Student?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_company")
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Franchise {
  id                   String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                 String
  razaoSocial          String?
  cnpj                 String?              @unique
  cpf                  String?
  dataNasc             DateTime?            @db.Timestamptz(6)
  responsavel          String
  email                String
  telefone             String?
  whatsapp             String?
  instagram            String?
  cidade               String
  uf                   String
  endereco             String?
  cep                  String?
  status               FranchiseStatus?     @default(ATIVO)
  mensalidade          Float?               @default(200)
  cobrarMensalidade    Boolean              @default(true)
  diaVencimentoTaxa    Int?                 @default(10)
  acessoBloqueado      Boolean              @default(false)
  bloqueadoEm          DateTime?            @db.Timestamptz(6)
  bloqueioMotivo       String?
  bloqueioLiberadoAte  DateTime?            @db.Timestamptz(6)
  plano                String?              @default("completo")
  pontuacao            Int?                 @default(0)
  chavePix             String?
  linkPagamento        String?
  instrucaoPagamento   String?
  createdAt            DateTime?            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  companies            Company[]
  contracts            Contract[]
  crmLeads             CrmLead[]
  employees            Employee[]
  financials           Financial[]
  gamification_configs GamificationConfig[]
  gamPoints            GamificationPoint[]
  students             Student[]
  users                User[]
  vacancies            Vacancy[]
  aiUsageLogs          AIUsageLog[]
  vagaSolicitacoes     VagaSolicitacao[]
  monthOpenings        MonthOpening[]

  @@map("franchises")
}

model Company {
  id               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  razaoSocial      String
  cnpj             String         @unique
  setor            String?
  email            String
  telefone         String?
  responsavel      String?
  cargoResponsavel String?
  endereco         String?
  bairro           String?
  cidade           String
  uf               String
  cep              String?
  site             String?
  status           CompanyStatus? @default(ATIVA)
  franchiseId      String?
  createdAt        DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  pendente         Boolean?       @default(false)
  emailFinanceiro  String?
  valorGestao      Float?
  cpsStatus        String?        @default("NAO_GERADO")
  cpsAuthDocId     String?
  cpsSignedUrl     String?
  franchise           Franchise?        @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts           Contract[]
  crmLeads            CrmLead[]
  financials          Financial[]
  users               User[]
  vacancies           Vacancy[]
  vagaSolicitacoes    VagaSolicitacao[]

  @@index([franchiseId])
  @@index([status])
  @@map("companies")
}

model Institution {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  razaoSocial String?
  cnpj        String?
  tipo        String?
  email       String?
  telefone    String?
  coordenador String?
  cargoCoord  String?
  cidade      String?
  uf          String?
  endereco    String?
  cep         String?
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  cursos      String[]   @default([])
  site        String?
  updatedAt   DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)

  // ─── Portal de Adesão IES ────────────────────────────────────────────────────
  // Token único gerado ao criar o convite — forma a URL pública do portal
  token                String?   @unique
  // Qual franqueado enviou o convite de adesão
  franchiseId          String?
  // Status do convênio
  convenioStatus       String?   @default("PENDENTE") // PENDENTE | FIRMADO | CANCELADO | AGUARDANDO_MINUTA
  // Dados de quem assinou pela IES
  convenioAssinadoEm   DateTime? @db.Timestamptz(6)
  assinanteName        String?
  assinanteEmail       String?
  assinanteCpf         String?
  assinanteIp          String?
  assinanteUserAgent   String?
  // Log completo da assinatura para auditoria
  assinaturaLog        Json?
  // Link para download da minuta assinada (gerado em PDF após assinatura)
  minutaAssinadaUrl    String?
  // Controle de envio do convite
  conviteEnviadoEm     DateTime? @db.Timestamptz(6)
  conviteEnviadoPor    String?   // userId do franqueado
  // Credenciais de acesso ao portal IES (geradas após assinar convênio)
  portalSenha          String?   // bcrypt hash da senha enviada por email
  // ─────────────────────────────────────────────────────────────────────────────

  contracts   Contract[]
  students    Student[]

  @@index([franchiseId])
  @@index([convenioStatus])
  @@index([token])
  @@map("institutions")
}

// Documentos institucionais da Smarter disponibilizados para as IES baixarem
model SmarterDocumento {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  nome      String    // "Cartão CNPJ", "Contrato Social", "Certidão Negativa", etc.
  tipo      String    @default("CERTIDAO") // CERTIDAO | CNPJ | ALVARA | CONTRATO | OUTRO
  url       String    // URL pública do arquivo
  descricao String?   // descrição opcional
  vigencia  DateTime? @db.Timestamptz(6)  // data de vencimento (certidões)
  tamanho   Int?      // bytes
  ativo     Boolean   @default(true)
  ordem     Int?      @default(0)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("smarter_documentos")
}

model Student {
  id                String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String         @unique
  name              String
  cpf               String?        @unique
  rg                String?
  dataNasc          DateTime?      @db.Timestamptz(6)
  sexo              String?
  email             String
  telefone          String?
  celular           String?
  endereco          String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  curso             String?
  periodo           String?
  semestre          String?
  previsaoConclusao String?
  institutionId     String?
  franchiseId       String?
  discResult        String?
  discData          Json?
  curriculo         Json?
  habilidades       String[]       @default([])
  idiomas           Json?
  observacoes       String?
  status            StudentStatus? @default(DISPONIVEL)
  createdAt         DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  menorDeIdade      Boolean?       @default(false)
  nomeResponsavel   String?
  linkedin          String?
  portfolio         String?
  experiencias      Json?
  formacoes         Json?
  objetivos         String?
  applications      Application[]
  contracts         Contract[]
  discTests         DiscTest[]
  franchise         Franchise?     @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution       Institution?   @relation(fields: [institutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@index([status])
  @@index([institutionId])
  @@map("students")
}

model Vacancy {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  titulo        String
  funcao        String?
  area          String?
  descricao     String?
  requisitos    String?
  beneficios    String?
  modalidade    String?        @default("Presencial")
  bolsa         Float
  auxTransporte Float?
  cargaHoraria  Int?           @default(30)
  chDiaria      Int?           @default(6)
  horario       String?
  diasSemana    String?
  cidade        String?
  uf            String?
  endereco      String?
  discDesejado   String?
  nivel          String?
  cursoRequerido String?
  status         VacancyStatus? @default(ABERTA)
  companyId     String
  franchiseId   String
  createdAt     DateTime?      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  publicSlug    String?
  applications  Application[]
  company       Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise     Franchise      @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@index([franchiseId])
  @@index([status])
  @@map("vacancies")
}

model Application {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId       String
  vacancyId       String
  etapa           String?   @default("inscritos")
  matching        Int?
  anotacao        String?
  entrevistaAt    DateTime? @db.Timestamptz(6)
  status          String?   @default("ativo")
  createdAt       DateTime? @default(now()) @db.Timestamptz(6)
  anotacaoInterna String?
  parecerTecnico  String?
  entrevistaLocal String?
  entrevistaLink  String?
  recomendacao    String?
  student         Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vacancy         Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentId])
  @@index([vacancyId])
  @@unique([studentId, vacancyId])
  @@map("applications")
}

model Contract {
  id               String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  numero           String?
  studentId        String
  companyId        String
  institutionId    String?
  franchiseId      String
  bolsa            Float
  valorEmpresa     Float?
  auxTransporte    Float?
  beneficios       String?
  vencimento       Int?                 @default(5)
  dataInicio       DateTime             @db.Timestamptz(6)
  dataFim          DateTime             @db.Timestamptz(6)
  atividades       String?
  localEstagio     String?
  cidade           String?
  uf               String?
  chDiaria         Int?                 @default(6)
  chSemanal        Int?                 @default(30)
  diasSemana       String?              @default("Segunda a Sexta")
  horarioInicio    String?              @default("08:00")
  horarioFim       String?              @default("14:00")
  intervalo        Int?                 @default(60)
  supervisorNome   String?
  supervisorCargo  String?
  supervisorEmail  String?
  supervisorTel    String?
  supervisorAssina Boolean?             @default(false)
  coordNome        String?
  coordCargo       String?
  coordEmail       String?
  coordTel         String?
  apoliceSeguro    String?
  seguradora       String?
  tipoEstagio      String?              @default("Nao Obrigatorio")
  modalidade       String?              @default("Presencial")
  status           ContractStatus?      @default(PENDENTE)
  origem           String?              @default("NORMAL")
  ativadoEm        DateTime?            @db.Timestamptz(6)
  migradoEm        DateTime?            @db.Timestamptz(6)
  migradoPor       String?
  migradoPorNome   String?
  tceMigradaUrl    String?
  createdAt        DateTime?            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise        Franchise            @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institution      Institution?         @relation(fields: [institutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student              @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evaluations      Evaluation[]
  financials       Financial[]
  documents        InternshipDocument[]

  @@index([franchiseId])
  @@index([status])
  @@index([companyId])
  @@index([studentId])
  @@map("contracts")
}

model InternshipDocument {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  contractId  String
  tipo        String
  titulo      String
  status      DocStatus? @default(NAO_GERADO)
  htmlContent String?
  pdfUrl      String?
  signedUrl   String?
  signedAt    DateTime?  @db.Timestamptz(6)
  signers     Json?
  authDocId   String?
  metaData    Json?
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)
  contract    Contract   @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contractId])
  @@index([status])
  @@map("internship_documents")
}

model Evaluation {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  contractId   String
  tipo         String?   @default("semestral")
  link         String?   @unique
  respostas    Json?
  atividades   String?
  observacoes  String?
  status       String?   @default("pendente")
  respondidoAt DateTime? @db.Timestamptz(6)
  pdfUrl       String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(6)
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("evaluations")
}

model CrmLead {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  empresa         String
  contato         String?
  cargo           String?
  email           String?
  telefone        String?
  whatsapp        String?
  instagram       String?
  linkedin        String?
  cidade          String?
  uf              String?
  etapa           String?   @default("novo_lead")
  prioridade      String?   @default("media")
  valorNegociado  Float?
  retornoAt       DateTime? @db.Timestamptz(6)
  ultimoContato   DateTime? @db.Timestamptz(6)
  proximaAcao     String?
  anotacao        String?
  franchiseId     String?
  companyId       String?
  convertido      Boolean?  @default(false)
  createdAt       DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  linkReuniao     String?
  enderecoReuniao String?
  reuniaoAt       DateTime? @db.Timestamptz(6)
  situacao        String?   @default("ativo")
  etapaChangedAt  DateTime? @db.Timestamptz(6)
  optIn           Boolean?  @default(false)
  optInAt         DateTime? @db.Timestamptz(6)
  origem          String?
  setor           String?
  contratoHtml    String?   @db.Text

  // ─── Apresentação Comercial Rastreável ───────────────────────────────────────
  apresentacaoToken      String?   @unique
  apresentacaoCanal      String?   // email | whatsapp | instagram | linkedin | link
  apresentacaoEnviadaEm  DateTime? @db.Timestamptz(6)
  apresentacaoAbertaEm   DateTime? @db.Timestamptz(6)
  apresentacaoAcessos    Int?      @default(0)
  apresentacaoTempoSeg   Int?      @default(0)
  apresentacaoScrollMax  Int?      @default(0)
  apresentacaoCliques    String?   @db.Text   // JSON array de cliques
  leadScore              Int?      @default(0)
  // ─────────────────────────────────────────────────────────────────────────────

  company              Company?              @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise            Franchise?            @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notas                CrmNota[]
  tasks                CrmTask[]
  apresentacaoEventos  ApresentacaoEvento[]

  @@index([franchiseId])
  @@index([situacao])
  @@index([updatedAt])
  @@index([apresentacaoToken])
  @@map("crm_leads")
}

model ApresentacaoEvento {
  id        String    @id @default(cuid())
  leadId    String
  token     String
  tipo      String    // abriu | scroll_25 | scroll_50 | scroll_75 | chegou_ao_fim | clicou_whatsapp | clicou_agendamento | clicou_vaga | ping_tempo
  ip        String?
  userAgent String?
  extra     String?   // JSON com dados extras (tempo em s, scroll %)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  lead      CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([leadId])
  @@index([token])
  @@index([tipo])
  @@map("apresentacao_eventos")
}

model CrmNota {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  leadId    String
  texto     String
  tipo      String    @default("anotacao")
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  lead      CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("crm_notas")
}

model CrmTask {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  leadId      String
  descricao   String
  dueAt       DateTime? @db.Timestamptz(6)
  done        Boolean?  @default(false)
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  linkReuniao String?
  endereco    String?
  lead        CrmLead   @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("crm_tasks")
}

model Financial {
  id                 String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  descricao          String
  tipo               String
  valor              Float
  categoria          String?
  status             FinancialStatus? @default(PENDENTE)
  vencimentoAt       DateTime?        @db.Timestamptz(6)
  paidAt             DateTime?        @db.Timestamptz(6)
  cancelado          Boolean?         @default(false)
  franchiseId        String?
  companyId          String?
  contractId         String?
  createdAt          DateTime?        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  recorrente         Boolean?         @default(false)
  diaVencimento      Int?
  competencia        String?
  linkPagamento      String?
  chavePix           String?
  instrucaoPagamento String?
  coraInvoiceId      String?
  sendLogs           FinancialSendLog[]
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract           Contract?        @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  franchise          Franchise?       @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@index([status])
  @@index([contractId])
  @@index([companyId])
  @@index([vencimentoAt])
  @@index([competencia])
  @@map("financials")
}


model FinancialSendLog {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  financialId String
  emailEnviado String
  enviadoPor  String?
  enviadoAt   DateTime  @default(now()) @db.Timestamptz(6)
  status      String?   @default("enviado")
  mensagem    String?
  financial   Financial @relation(fields: [financialId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("financial_send_logs")
}

model DiscTest {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId String
  respostas Json
  resultado String
  grafico   Json
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("disc_tests")
}

model GamificationConfig {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  franchiseId String?
  acao        String
  pontos      Int
  ativo       Boolean?   @default(true)
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  franchises  Franchise? @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([franchiseId, acao])
  @@map("gamification_configs")
}

model GamificationPoint {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  franchiseId String
  acao        String
  pontos      Int
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ⚡ ESC-003: indexes para ranking groupBy e queries por franquia
  @@index([franchiseId])
  @@index([createdAt])
  @@map("gamification_points")
}

model ActivityLog {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?
  acao      String
  modulo    String?
  detalhes  String?
  ip        String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ⚡ ESC-003: indexes para auditoria por usuário e cleanup por data
  @@index([userId])
  @@index([createdAt])
  @@index([modulo])
  @@map("activity_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  titulo    String
  mensagem  String
  lida      Boolean?  @default(false)
  tipo      String?
  link      String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ⚡ ESC-003: indexes para query de notificações não lidas no dashboard
  @@index([userId])
  @@index([lida])
  @@index([createdAt])
  @@map("notifications")
}

model UploadedFile {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  nome         String
  url          String
  tipo         String?
  tamanho      Int?
  referencia   String?
  referenciaId String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(6)

  @@map("uploaded_files")
}

model Employee {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @unique
  franchiseId String?
  cargo       String?
  permissoes  String[]  @default([])
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([franchiseId])
  @@map("employees")
}

model SystemConfig {
  id             String    @id @default("default")
  razaoSocial    String?   @default("Smarter Estágios Agente de Integração Ltda.")
  cnpj           String?   @default("")
